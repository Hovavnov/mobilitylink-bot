# העתיקו לקובץ .env ומלאו ערכים. לעולם אל תעלו את .env ל-GitHub.
OPENAI_API_KEY=sk-...
IMAGE_MODEL=gpt-image-1
IMAGE_QUALITY=high
IMAGE_SIZE=1024x1536
INPUT_FIDELITY=high
# סיסמה משותפת בין האפליקציה לשרת (אותו ערך ב-EXPO_PUBLIC_APP_TOKEN באפליקציה)
APP_TOKEN=change-me
RATE_LIMIT_PER_HOUR=20
PORT=8787
